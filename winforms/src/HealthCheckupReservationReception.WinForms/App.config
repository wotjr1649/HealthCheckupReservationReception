<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <appSettings>
    <!-- 03 §1.3 — 조작자. 읽기 전용 표시값이자 Write SP 의 @조작자명 이다.
         로그인·권한·사용자별 개인화는 구현하지 않는다. 창구마다 이 값을 다르게 배포한다. -->
    <add key="OperatorName" value="접수1번창구" />
  </appSettings>
  <connectionStrings>
    <!-- 키 이름과 DB 이름은 docs/baseline/05_DB_Rule_SP_Contract.md §1.1 이 확정한다.
         킷 contract/repository.md 의 AppDb 는 킷 예시 이름이다 ("Copy the shape, not the names") —
         winforms/AGENTS.md 가 05 를 킷 위에 둔다.
         통합인증만 쓴다. 계정을 싣거나 통합인증을 끄는 형태는 scripts/verify-no-secret.sh 가 막는다. -->
    <add name="HealthCheckupDb"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=HealthCheckupReservationReceptionDb;Integrated Security=True"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
